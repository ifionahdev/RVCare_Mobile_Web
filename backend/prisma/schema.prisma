generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tbl_account {
  account_id              Int                       @id @default(autoincrement())
  role_id                 Int
  username                String                    @unique(map: "tbl_account_username") @db.VarChar(50)
  password                String                    @db.VarChar(255)
  first_name              String                    @db.VarChar(100)
  last_name               String                    @db.VarChar(100)
  date_registered         DateTime                  @default(now()) @db.DateTime(0)
  tbl_role                tbl_role                  @relation(fields: [role_id], references: [role_id], onUpdate: Restrict, map: "tbl_account_tbl_role_FK")
  tbl_admin               tbl_admin[]
  tbl_medical_record_file tbl_medical_record_file[]
  tbl_password_reset      tbl_password_reset[]
  tbl_pet_owner           tbl_pet_owner[]
  tbl_veterinarian        tbl_veterinarian[]

  @@index([role_id], map: "tbl_account_tbl_role_FK")
}

model tbl_activity_log {
  activity_id Int      @id @default(autoincrement())
  account_id  Int
  action      String   @db.VarChar(100)
  source      String   @db.VarChar(100)
  created_at  DateTime @default(now()) @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tbl_admin {
  admin_id    Int         @id
  account_id  Int
  is_deleted  Boolean?    @default(false)
  tbl_account tbl_account @relation(fields: [account_id], references: [account_id], onUpdate: Restrict, map: "tbl_admin_tbl_account_FK")

  @@index([account_id], map: "tbl_admin_tbl_account_FK")
}

model tbl_appointment {
  appointment_id Int                    @id @default(autoincrement())
  pet_id         Int
  service_id     Int
  scheduled_date DateTime?              @db.Date
  scheduled_time DateTime?              @db.Time(0)
  status         tbl_appointment_status
  created_at     DateTime?              @default(now()) @db.DateTime(0)
  last_updated   DateTime?              @default(now()) @db.DateTime(0)
  is_deleted     Boolean?               @default(false)
  tbl_pet        tbl_pet                @relation(fields: [pet_id], references: [pet_id], onUpdate: Restrict, map: "tbl_appointment_tbl_pet_FK")
  tbl_service    tbl_service            @relation(fields: [service_id], references: [service_id], onUpdate: Restrict, map: "tbl_appointment_tbl_service_FK")
  tbl_visit      tbl_visit[]

  @@index([pet_id], map: "tbl_appointment_tbl_pet_FK")
  @@index([service_id], map: "tbl_appointment_tbl_service_FK")
}

model tbl_audit_log {
  audit_id     Int                  @id @default(autoincrement())
  action       tbl_audit_log_action
  target_table String               @db.VarChar(100)
  target_id    Int
  old_value    String?              @db.LongText
  new_value    String?              @db.LongText
  created_at   DateTime             @default(now()) @db.DateTime(0)
}

model tbl_medical_record {
  record_id               Int                       @id @default(autoincrement())
  visit_id                Int
  record_type_id          Int
  tbl_medical_record_type tbl_medical_record_type   @relation(fields: [record_type_id], references: [record_type_id], onUpdate: Restrict, map: "tbl_medical_record_tbl_medical_record_type_FK")
  tbl_visit               tbl_visit                 @relation(fields: [visit_id], references: [visit_id], onUpdate: Restrict, map: "tbl_medical_record_tbl_visit_FK")
  tbl_medical_record_file tbl_medical_record_file[]

  @@index([record_type_id], map: "tbl_medical_record_tbl_medical_record_type_FK")
  @@index([visit_id], map: "tbl_medical_record_tbl_visit_FK")
}

model tbl_medical_record_file {
  record_file_id      Int                @id @default(autoincrement())
  record_id           Int
  original_name       String             @db.VarChar(255)
  storage_key         String             @db.VarChar(255)
  mime_type           String             @db.VarChar(100)
  file_size_bytes     Int
  checksum            String             @db.Char(64)
  uploader_account_id Int
  uploaded_at         DateTime?          @default(now()) @db.DateTime(0)
  is_deleted          Boolean?           @default(false)
  tbl_account         tbl_account        @relation(fields: [uploader_account_id], references: [account_id], onUpdate: Restrict, map: "tbl_medical_record_file_tbl_account_FK")
  tbl_medical_record  tbl_medical_record @relation(fields: [record_id], references: [record_id], onUpdate: Restrict, map: "tbl_medical_record_file_tbl_medical_record_FK")

  @@index([uploader_account_id], map: "tbl_medical_record_file_tbl_account_FK")
  @@index([record_id], map: "tbl_medical_record_file_tbl_medical_record_FK")
}

model tbl_medical_record_type {
  record_type_id     Int                  @id @default(autoincrement())
  record_type        String?              @unique(map: "tbl_medical_record_type_unique") @db.VarChar(100)
  description        String?              @db.VarChar(255)
  tbl_medical_record tbl_medical_record[]
}

model tbl_pet {
  pet_id          Int               @id @default(autoincrement())
  owner_id        Int
  pet_name        String            @db.VarChar(100)
  breed_id        Int
  gender          tbl_pet_gender
  date_registered DateTime          @default(now()) @db.DateTime(0)
  is_deleted      Boolean           @default(false)
  tbl_appointment tbl_appointment[]
  tbl_pet_breed   tbl_pet_breed     @relation(fields: [breed_id], references: [breed_id], onUpdate: Restrict, map: "tbl_pet_tbl_pet_breed_FK")
  tbl_visit       tbl_visit[]

  @@index([breed_id], map: "tbl_pet_tbl_pet_breed_FK")
}

model tbl_pet_breed {
  breed_id   Int                   @id @default(autoincrement())
  species    tbl_pet_breed_species
  breed_name String                @db.VarChar(100)
  is_deleted Boolean?              @default(false)
  tbl_pet    tbl_pet[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tbl_pet_owner {
  owner_id          Int         @id @default(autoincrement())
  account_id        Int
  address           String?     @db.VarChar(100)
  contact_number    String?     @db.VarChar(11)
  alternate_contact String?     @db.VarChar(100)
  is_deleted        Boolean     @default(false)
  tbl_account       tbl_account @relation(fields: [account_id], references: [account_id], onUpdate: Restrict, map: "tbl_pet_owner_tbl_account_FK")

  @@index([account_id], map: "tbl_pet_owner_tbl_account_FK")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tbl_role {
  role_id     Int           @id @default(autoincrement())
  role_slug   String        @unique(map: "tbl_role_slug") @db.VarChar(50)
  role_name   String        @db.VarChar(100)
  tbl_account tbl_account[]
}

model tbl_service {
  service_id      Int               @id @default(autoincrement())
  service_name    String?           @db.VarChar(100)
  description     String?           @db.VarChar(255)
  tbl_appointment tbl_appointment[]
  tbl_visit       tbl_visit[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tbl_veterinarian {
  vet_id      Int         @id @default(autoincrement())
  account_id  Int
  is_deleted  Boolean?    @default(false)
  tbl_account tbl_account @relation(fields: [account_id], references: [account_id], onUpdate: Restrict, map: "tbl_veterinarian_tbl_account_FK")

  @@index([account_id], map: "tbl_veterinarian_tbl_account_FK")
}

model tbl_visit {
  visit_id           Int                  @id @default(autoincrement())
  appointment_id     Int?
  pet_id             Int
  service_id         Int
  visit_date         DateTime             @default(dbgenerated("(curdate())")) @db.Date
  visit_time         DateTime             @default(dbgenerated("(curtime())")) @db.Time(0)
  status             tbl_visit_status?
  is_deleted         Boolean?             @default(false)
  tbl_medical_record tbl_medical_record[]
  tbl_appointment    tbl_appointment?     @relation(fields: [appointment_id], references: [appointment_id], onDelete: Restrict, onUpdate: Restrict, map: "tbl_visit_tbl_appointment_FK")
  tbl_pet            tbl_pet              @relation(fields: [pet_id], references: [pet_id], onUpdate: Restrict, map: "tbl_visit_tbl_pet_FK")
  tbl_service        tbl_service          @relation(fields: [service_id], references: [service_id], onUpdate: Restrict, map: "tbl_visit_tbl_service_FK")

  @@index([appointment_id], map: "tbl_visit_tbl_appointment_FK")
  @@index([pet_id], map: "tbl_visit_tbl_pet_FK")
  @@index([service_id], map: "tbl_visit_tbl_service_FK")
}

model tbl_password_reset {
  reset_id      BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  account_id    Int
  token_hash    String      @unique(map: "token_hash") @db.Char(64)
  expires_at    DateTime    @db.DateTime(0)
  used_at       DateTime?   @db.DateTime(0)
  created_at    DateTime    @default(now()) @db.DateTime(0)
  platform      String      @default("web") @db.VarChar(10)
  attempt_count Int         @default(0)
  tbl_account   tbl_account @relation(fields: [account_id], references: [account_id], onDelete: Cascade, onUpdate: Restrict, map: "tbl_password_reset_ibfk_1")

  @@index([account_id], map: "idx_password_reset_account")
}

enum tbl_audit_log_action {
  Created
  Updated
  Deleted
}

enum tbl_pet_breed_species {
  Cat
  Dog
}

enum tbl_pet_gender {
  Male
  Female
}

enum tbl_appointment_status {
  Pending
  Incoming
  Completed
  Missed
  Cancelled
}

enum tbl_visit_status {
  Checked_in @map("Checked-in")
  Ongoing
  Completed
}
