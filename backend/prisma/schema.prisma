generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Account {
  account_id      Int      @id @default(autoincrement())
  role_id         Int
  username        String   @unique(map: "tbl_account_username") @db.VarChar(50)
  password        String   @db.VarChar(255)
  first_name      String   @db.VarChar(100)
  last_name       String   @db.VarChar(100)
  date_registered DateTime @default(now()) @db.DateTime(0)

  role           Role                @relation(fields: [role_id], references: [role_id], onUpdate: Restrict, map: "tbl_account_tbl_role_FK")
  admin          Admin?
  veterinarian   Veterinarian?
  petOwner       PetOwner?
  uploadedFiles  MedicalRecordFile[]
  passwordResets PasswordReset[]
  activityLogs   ActivityLog[]

  @@index([role_id], map: "tbl_account_tbl_role_FK")
  @@map("tbl_account")
}

model ActivityLog {
  activity_id Int      @id @default(autoincrement())
  account_id  Int
  action      String   @db.VarChar(100)
  source      String   @db.VarChar(100)
  created_at  DateTime @default(now()) @db.DateTime(0)

  account Account @relation(fields: [account_id], references: [account_id], onUpdate: Restrict, map: "tbl_activity_log_tbl_account_FK")

  @@index([account_id], map: "tbl_activity_log_tbl_account_FK")
  @@map("tbl_activity_log")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Admin {
  admin_id   Int     @id @default(autoincrement())
  account_id Int     @unique
  is_deleted Boolean @default(false)

  account Account @relation(fields: [account_id], references: [account_id], onUpdate: Restrict, map: "tbl_admin_tbl_account_FK")

  @@index([account_id], map: "tbl_admin_tbl_account_FK")
  @@map("tbl_admin")
}

model Appointment {
  appointment_id Int                    @id @default(autoincrement())
  pet_id         Int
  service_id     Int
  scheduled_date DateTime               @db.Date
  scheduled_time DateTime               @db.Time(0)
  status         tbl_appointment_status @default(Pending)
  created_at     DateTime               @default(now()) @db.DateTime(0)
  last_updated   DateTime               @default(now()) @db.DateTime(0)
  is_deleted     Boolean                @default(false)

  pet     Pet     @relation(fields: [pet_id], references: [pet_id], onUpdate: Restrict, map: "tbl_appointment_tbl_pet_FK")
  service Service @relation(fields: [service_id], references: [service_id], onUpdate: Restrict, map: "tbl_appointment_tbl_service_FK")
  visits  Visit[]

  @@index([pet_id], map: "tbl_appointment_tbl_pet_FK")
  @@index([service_id], map: "tbl_appointment_tbl_service_FK")
  @@map("tbl_appointment")
}

model AuditLog {
  audit_id     Int                  @id @default(autoincrement())
  action       tbl_audit_log_action
  target_table String               @db.VarChar(100)
  target_id    Int
  old_value    String?              @db.LongText
  new_value    String?              @db.LongText
  created_at   DateTime             @default(now()) @db.DateTime(0)

  @@map("tbl_audit_log")
}

model MedicalRecord {
  record_id      Int @id @default(autoincrement())
  visit_id       Int
  record_type_id Int

  recordType MedicalRecordType   @relation(fields: [record_type_id], references: [record_type_id], onUpdate: Restrict, map: "tbl_medical_record_tbl_medical_record_type_FK")
  visit      Visit               @relation(fields: [visit_id], references: [visit_id], onUpdate: Restrict, map: "tbl_medical_record_tbl_visit_FK")
  files      MedicalRecordFile[]

  @@index([record_type_id], map: "tbl_medical_record_tbl_medical_record_type_FK")
  @@index([visit_id], map: "tbl_medical_record_tbl_visit_FK")
  @@map("tbl_medical_record")
}

model MedicalRecordFile {
  record_file_id      Int      @id @default(autoincrement())
  record_id           Int
  original_name       String   @db.VarChar(255)
  storage_key         String   @db.VarChar(255)
  mime_type           String   @db.VarChar(100)
  file_size_bytes     Int
  checksum            String   @db.Char(64)
  uploader_account_id Int
  uploaded_at         DateTime @default(now()) @db.DateTime(0)
  is_deleted          Boolean  @default(false)

  uploader Account       @relation(fields: [uploader_account_id], references: [account_id], onUpdate: Restrict, map: "tbl_medical_record_file_tbl_account_FK")
  record   MedicalRecord @relation(fields: [record_id], references: [record_id], onUpdate: Restrict, map: "tbl_medical_record_file_tbl_medical_record_FK")

  @@index([uploader_account_id], map: "tbl_medical_record_file_tbl_account_FK")
  @@index([record_id], map: "tbl_medical_record_file_tbl_medical_record_FK")
  @@map("tbl_medical_record_file")
}

model MedicalRecordType {
  record_type_id Int     @id @default(autoincrement())
  record_type    String  @unique(map: "tbl_medical_record_type_unique") @db.VarChar(100)
  description    String? @db.VarChar(255)

  records MedicalRecord[]

  @@map("tbl_medical_record_type")
}

model Pet {
  pet_id          Int            @id @default(autoincrement())
  owner_id        Int
  pet_name        String         @db.VarChar(100)
  breed_id        Int
  gender          tbl_pet_gender
  date_registered DateTime       @default(now()) @db.DateTime(0)
  is_deleted      Boolean        @default(false)

  owner        PetOwner      @relation(fields: [owner_id], references: [owner_id], onUpdate: Restrict, map: "tbl_pet_tbl_pet_owner_FK")
  breed        PetBreed      @relation(fields: [breed_id], references: [breed_id], onUpdate: Restrict, map: "tbl_pet_tbl_pet_breed_FK")
  appointments Appointment[]
  visits       Visit[]

  @@index([breed_id], map: "tbl_pet_tbl_pet_breed_FK")
  @@index([owner_id], map: "tbl_pet_tbl_pet_owner_FK")
  @@map("tbl_pet")
}

model PetBreed {
  breed_id   Int                   @id @default(autoincrement())
  species    tbl_pet_breed_species
  breed_name String                @db.VarChar(100)
  is_deleted Boolean               @default(false)

  pets Pet[]

  @@map("tbl_pet_breed")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model PetOwner {
  owner_id          Int     @id @default(autoincrement())
  account_id        Int     @unique
  address           String? @db.VarChar(100)
  contact_number    String? @db.VarChar(11)
  alternate_contact String? @db.VarChar(100)
  is_deleted        Boolean @default(false)

  account Account @relation(fields: [account_id], references: [account_id], onUpdate: Restrict, map: "tbl_pet_owner_tbl_account_FK")
  pets    Pet[]

  @@index([account_id], map: "tbl_pet_owner_tbl_account_FK")
  @@map("tbl_pet_owner")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Role {
  role_id   Int    @id @default(autoincrement())
  role_slug String @unique(map: "tbl_role_slug") @db.VarChar(50)
  role_name String @db.VarChar(100)

  accounts Account[]

  @@map("tbl_role")
}

model Service {
  service_id   Int     @id @default(autoincrement())
  service_name String  @db.VarChar(100)
  description  String? @db.VarChar(255)

  appointments Appointment[]
  visits       Visit[]

  @@map("tbl_service")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Veterinarian {
  vet_id     Int     @id @default(autoincrement())
  account_id Int     @unique
  is_deleted Boolean @default(false)

  account Account @relation(fields: [account_id], references: [account_id], onUpdate: Restrict, map: "tbl_veterinarian_tbl_account_FK")

  @@index([account_id], map: "tbl_veterinarian_tbl_account_FK")
  @@map("tbl_veterinarian")
}

model Visit {
  visit_id       Int               @id @default(autoincrement())
  appointment_id Int?
  pet_id         Int
  service_id     Int
  visit_date     DateTime          @default(dbgenerated("(curdate())")) @db.Date
  visit_time     DateTime          @default(dbgenerated("(curtime())")) @db.Time(0)
  status         tbl_visit_status?
  is_deleted     Boolean?          @default(false)

  appointment    Appointment?    @relation(fields: [appointment_id], references: [appointment_id], onDelete: Restrict, onUpdate: Restrict, map: "tbl_visit_tbl_appointment_FK")
  pet            Pet             @relation(fields: [pet_id], references: [pet_id], onUpdate: Restrict, map: "tbl_visit_tbl_pet_FK")
  service        Service         @relation(fields: [service_id], references: [service_id], onUpdate: Restrict, map: "tbl_visit_tbl_service_FK")
  medicalRecords MedicalRecord[]

  @@index([appointment_id], map: "tbl_visit_tbl_appointment_FK")
  @@index([pet_id], map: "tbl_visit_tbl_pet_FK")
  @@index([service_id], map: "tbl_visit_tbl_service_FK")
  @@map("tbl_visit")
}

model PasswordReset {
  reset_id      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  account_id    Int
  token_hash    String    @unique(map: "token_hash") @db.Char(64)
  expires_at    DateTime  @db.DateTime(0)
  used_at       DateTime? @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  platform      String    @default("web") @db.VarChar(10)
  attempt_count Int       @default(0)

  account Account @relation(fields: [account_id], references: [account_id], onDelete: Cascade, onUpdate: Restrict, map: "tbl_password_reset_ibfk_1")

  @@index([account_id], map: "idx_password_reset_account")
  @@map("tbl_password_reset")
}

enum tbl_audit_log_action {
  Created
  Updated
  Deleted
}

enum tbl_pet_breed_species {
  Cat
  Dog
}

enum tbl_pet_gender {
  Male
  Female
}

enum tbl_appointment_status {
  Pending
  Incoming
  Completed
  Missed
  Cancelled
}

enum tbl_visit_status {
  Checked_in @map("Checked-in")
  Ongoing
  Completed
}
