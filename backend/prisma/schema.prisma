generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model Account {
  accountId      Int        @id @default(autoincrement()) @map("account_id")
  roleId         Int        @map("role_id")
  username       String     @unique(map: "tbl_account_username") @db.VarChar(50)
  email          String     @unique(map: "tbl_account_email") @db.VarChar(255)
  isDeleted      Boolean    @default(false) @map("is_deleted")
  gender         PetGender?
  dateOfBirth    DateTime?  @map("date_of_birth") @db.Date
  password       String     @db.VarChar(255)
  firstName      String     @map("first_name") @db.VarChar(100)
  lastName       String     @map("last_name") @db.VarChar(100)
  dateRegistered DateTime   @default(now()) @map("date_registered") @db.DateTime(0)

  role               Role            @relation(fields: [roleId], references: [roleId], onUpdate: Restrict, map: "tbl_account_tbl_role_FK")
  admin              Admin?
  veterinarian       Veterinarian?
  petOwner           PetOwner?
  uploadedTips       PetCareTip[]
  uploadedVideos     ContentVideo[]
  uploadedAttachment Attachment[]
  passwordResets     PasswordReset[]
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]

  @@index([roleId], map: "tbl_account_tbl_role_FK")
  @@map("tbl_account")
}

model ActivityLog {
  activityId Int      @id @default(autoincrement()) @map("activity_id")
  accountId  Int      @map("account_id")
  action     String   @db.VarChar(100)
  source     String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  account Account @relation(fields: [accountId], references: [accountId], onUpdate: Restrict, map: "tbl_activity_log_tbl_account_FK")

  @@index([accountId], map: "tbl_activity_log_tbl_account_FK")
  @@map("tbl_activity_log")
}

model Admin {
  adminId   Int     @id @default(autoincrement()) @map("admin_id")
  accountId Int     @unique @map("account_id")
  isDeleted Boolean @default(false) @map("is_deleted")

  account Account @relation(fields: [accountId], references: [accountId], onUpdate: Restrict, map: "tbl_admin_tbl_account_FK")

  @@index([accountId], map: "tbl_admin_tbl_account_FK")
  @@map("tbl_admin")
}

model Appointment {
  appointmentId Int               @id @default(autoincrement()) @map("appointment_id")
  vetId         Int               @map("vet_id")
  petId         Int               @map("pet_id")
  serviceId     Int               @map("service_id")
  scheduledDate DateTime          @map("scheduled_date") @db.Date
  timeslotId    Int               @map("timeslot_id")
  status        AppointmentStatus @default(Pending)
  createdAt     DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  lastUpdated   DateTime          @default(now()) @updatedAt @map("last_updated") @db.DateTime(0)
  isDeleted     Boolean           @default(false) @map("is_deleted")

  timeslot     Timeslot     @relation(fields: [timeslotId], references: [timeslotId], onUpdate: Restrict, map: "tbl_appointment_tbl_timeslot_FK")
  veterinarian Veterinarian @relation(fields: [vetId], references: [vetId], onUpdate: Restrict, map: "tbl_appointment_tbl_veterinarian_FK")
  pet          Pet          @relation(fields: [petId], references: [petId], onUpdate: Restrict, map: "tbl_appointment_tbl_pet_FK")
  service      Service      @relation(fields: [serviceId], references: [serviceId], onUpdate: Restrict, map: "tbl_appointment_tbl_service_FK")
  visits       Visit?

  @@index([vetId, scheduledDate, timeslotId], map: "tbl_appointment_index_booked")
  @@index([petId], map: "tbl_appointment_tbl_pet_FK")
  @@index([serviceId], map: "tbl_appointment_tbl_service_FK")
  @@map("tbl_appointment")
}

model AuditLog {
  auditId     Int            @id @default(autoincrement()) @map("audit_id")
  action      AuditLogAction
  accountId   Int?           @map("account_id")
  targetTable String         @map("target_table") @db.VarChar(100)
  targetId    Int            @map("target_id")
  oldValue    Json?          @map("old_value")
  newValue    Json?          @map("new_value")
  hash        String         @db.Char(64)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(0)

  account Account? @relation(fields: [accountId], references: [accountId], onUpdate: Restrict, map: "tbl_audit_log_tbl_account_FK")

  @@index([accountId], map: "tbl_audit_log_tbl_account_FK")
  @@index([targetTable, targetId], map: "tbl_audit_log_index_target")
  @@index([createdAt], map: "tbl_audit_log_index_created_at")
  @@index([action], map: "tbl_audit_log_index_action")
  @@map("tbl_audit_log")
}

model MedicalHistory {
  historyId     Int      @id @default(autoincrement()) @map("record_id")
  visitId       Int      @map("visit_id")
  weightKg      Decimal? @map("weight_kg") @db.Decimal(5, 2)
  temperature   Decimal? @map("temperature") @db.Decimal(4, 1)
  heartRate     Int?     @map("heart_rate")
  findings      Json?    @map("findings")
  assessment    Json?    @map("assessment")
  treatmentPlan Json?    @map("treatment_plan")
  instructions  Json?    @map("instructions")

  visit       Visit        @relation(fields: [visitId], references: [visitId], onUpdate: Restrict, map: "tbl_medical_record_tbl_visit_FK")
  attachments Attachment[]

  @@index([visitId], map: "tbl_medical_record_tbl_visit_FK")
  @@map("tbl_medical_history")
}

model LabResult {
  labResultId    Int             @id @default(autoincrement()) @map("lab_result_id")
  visitId        Int             @map("visit_id")
  testTypeId     Int             @map("test_type_id")
  interpretation String?         @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(0)

  testType        LabTestType      @relation(fields: [testTypeId], references: [testTypeId], onUpdate: Restrict, map: "tbl_lab_result_tbl_lab_test_type_FK")
  visit           Visit            @relation(fields: [visitId], references: [visitId], onUpdate: Restrict, map: "tbl_lab_result_tbl_visit_FK")
  attachments     Attachment[]
  labResultValues LabResultValue[]

  @@index([visitId], map: "tbl_lab_result_tbl_visit_FK")
  @@map("tbl_lab_result")
}

model LabTestType {
  testTypeId Int     @id @default(autoincrement()) @map("test_type_id")
  code       String  @unique(map: "tbl_lab_test_type_code") @map("test_code") @db.VarChar(20)
  name       String  @map("test_name") @db.VarChar(100)
  isActive   Boolean @default(true) @map("is_active")
  isDeleted  Boolean @default(false) @map("is_deleted")

  parameters LabTestParameter[]
  labResults LabResult[]

  @@map("tbl_lab_test_type")
}

model LabTestParameter {
  parameterId  Int     @id @default(autoincrement()) @map("parameter_id")
  testTypeId   Int     @map("test_type_id")
  name         String  @map("parameter_name") @db.VarChar(100)
  unit         String? @db.VarChar(20)
  refRangeText String? @map("ref_range_text") @db.VarChar(100)
  displayOrder Int?    @map("display_order")
  isDeleted    Boolean @default(false) @map("is_deleted")

  testType        LabTestType      @relation(fields: [testTypeId], references: [testTypeId], onUpdate: Restrict, map: "tbl_lab_test_parameter_tbl_lab_test_type_FK")
  labResultValues LabResultValue[]

  @@index([testTypeId], map: "tbl_lab_test_parameter_tbl_lab_test_type_FK")
  @@map("tbl_lab_test_parameter")
}

model LabResultValue {
  valueId     Int      @id @default(autoincrement()) @map("value_id")
  labResultId Int      @map("lab_result_id")
  parameterId Int      @map("parameter_id")
  value       Decimal? @db.Decimal(10, 2)
  textValue   String?  @map("text_value") @db.VarChar(100)
  isDeleted   Boolean  @default(false) @map("is_deleted")

  labResult LabResult        @relation(fields: [labResultId], references: [labResultId], onUpdate: Restrict, map: "tbl_lab_result_value_tbl_lab_result_FK")
  parameter LabTestParameter @relation(fields: [parameterId], references: [parameterId], onUpdate: Restrict, map: "tbl_lab_result_value_tbl_lab_test_parameter_FK")

  @@index([labResultId], map: "tbl_lab_result_value_tbl_lab_result_FK")
  @@index([parameterId], map: "tbl_lab_result_value_tbl_lab_test_parameter_FK")
  @@map("tbl_lab_result_value")
}

model Attachment {
  attachmentId      Int      @id @default(autoincrement()) @map("attachment_id")
  medicalHistoryId  Int?     @map("medical_history_id")
  labResultId       Int?     @map("lab_result_id")
  originalName      String   @map("original_name") @db.VarChar(255)
  storageKey        String   @map("storage_key") @db.VarChar(255)
  mimeType          String   @map("mime_type") @db.VarChar(100)
  fileSizeBytes     Int      @map("file_size_bytes")
  checksum          String   @db.Char(64)
  uploaderAccountId Int      @map("uploader_account_id")
  uploadedAt        DateTime @default(now()) @map("uploaded_at") @db.DateTime(0)
  isDeleted         Boolean  @default(false) @map("is_deleted")

  labResult      LabResult?      @relation(fields: [labResultId], references: [labResultId], onUpdate: Restrict, map: "tbl_attachment_tbl_lab_result_FK")
  medicalHistory MedicalHistory? @relation(fields: [medicalHistoryId], references: [historyId], onUpdate: Restrict, map: "tbl_attachment_tbl_medical_history_FK")
  uploader       Account         @relation(fields: [uploaderAccountId], references: [accountId], onUpdate: Restrict, map: "tbl_attachment_tbl_account_FK")

  @@index([medicalHistoryId], map: "tbl_attachment_tbl_medical_history_FK")
  @@index([labResultId], map: "tbl_attachment_tbl_lab_result_FK")
  @@index([uploaderAccountId], map: "tbl_attachment_tbl_account_FK")
  @@map("tbl_attachment")
}

model PasswordReset {
  resetId      BigInt    @id @default(autoincrement()) @map("reset_id") @db.UnsignedBigInt
  accountId    Int       @map("account_id")
  tokenHash    String    @unique(map: "token_hash") @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(0)
  usedAt       DateTime? @map("used_at") @db.DateTime(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  platform     String    @default("web") @db.VarChar(10)
  attemptCount Int       @default(0) @map("attempt_count")

  account Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: Restrict, map: "tbl_password_reset_ibfk_1")

  @@index([accountId], map: "idx_password_reset_account")
  @@map("tbl_password_reset")
}

model Pet {
  petId          Int       @id @default(autoincrement()) @map("pet_id")
  ownerId        Int       @map("owner_id")
  petName        String    @map("pet_name") @db.VarChar(100)
  breedId        Int       @map("breed_id")
  gender         PetGender
  dateOfBirth    DateTime  @map("date_of_birth") @db.Date
  weightKg       Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  color          String?   @db.VarChar(100)
  note           String?   @db.VarChar(500)
  dateRegistered DateTime  @default(now()) @map("date_registered") @db.DateTime(0)
  isDeleted      Boolean   @default(false) @map("is_deleted")

  owner        PetOwner      @relation(fields: [ownerId], references: [ownerId], onUpdate: Restrict, map: "tbl_pet_tbl_pet_owner_FK")
  breed        PetBreed      @relation(fields: [breedId], references: [breedId], onUpdate: Restrict, map: "tbl_pet_tbl_pet_breed_FK")
  appointments Appointment[]
  visits       Visit[]

  @@index([breedId], map: "tbl_pet_tbl_pet_breed_FK")
  @@index([ownerId], map: "tbl_pet_tbl_pet_owner_FK")
  @@map("tbl_pet")
}

model PetBreed {
  breedId   Int             @id @default(autoincrement()) @map("breed_id")
  species   PetBreedSpecies
  breedName String          @map("breed_name") @db.VarChar(100)
  isDeleted Boolean         @default(false) @map("is_deleted")

  pets Pet[]

  @@map("tbl_pet_breed")
}

model PetOwner {
  ownerId           Int     @id @default(autoincrement()) @map("owner_id")
  accountId         Int     @unique @map("account_id")
  address           String? @db.VarChar(100)
  contactNumber     String? @map("contact_number") @db.VarChar(11)
  alternateContact  String? @map("alternate_contact") @db.VarChar(100)
  emailNotification Boolean @default(true) @map("email_notification")
  phoneNotification Boolean @default(true) @map("phone_notification")
  isDeleted         Boolean @default(false) @map("is_deleted")

  account Account @relation(fields: [accountId], references: [accountId], onUpdate: Restrict, map: "tbl_pet_owner_tbl_account_FK")
  pets    Pet[]

  @@index([accountId], map: "tbl_pet_owner_tbl_account_FK")
  @@map("tbl_pet_owner")
}

model PetCareTip {
  tipId               Int            @id @default(autoincrement()) @map("tip_id")
  type                PetCareTipType
  title               String         @db.VarChar(100)
  imageUrl            String?        @map("image_url") @db.VarChar(255)
  linkUrl             String         @map("link_url") @db.VarChar(255)
  uploaderAccountId   Int            @map("uploader_account_id")
  createdAt           DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  isDeleted           Boolean        @default(false) @map("is_deleted")
  shortDescription    String?        @map("short_description") @db.VarChar(180)
  detailedContent     String?        @map("detailed_content") @db.VarChar(500)
  iconId              Int?           @map("icon_id")
  publicationStatusId Int?           @map("publication_status_id")
  contentCategoryId   Int?           @map("content_category_id")

  uploader          Account            @relation(fields: [uploaderAccountId], references: [accountId], onUpdate: Restrict, map: "tbl_pet_care_tips_tbl_account_FK")
  icon              PetCareIcon?       @relation(fields: [iconId], references: [iconId], onUpdate: Restrict, onDelete: SetNull)
  publicationStatus PublicationStatus? @relation(fields: [publicationStatusId], references: [statusId], onUpdate: Restrict, onDelete: SetNull)
  contentCategory   PetCareCategory?   @relation(fields: [contentCategoryId], references: [categoryId], onUpdate: Restrict, onDelete: SetNull)

  @@map("tbl_pet_care_tip")
}

model PetCareCategory {
  categoryId   Int          @id @default(autoincrement()) @map("category_id")
  categoryName String       @unique(map: "tbl_pet_care_category_name") @map("category_name") @db.VarChar(80)
  isDeleted    Boolean      @default(false) @map("is_deleted")
  tips         PetCareTip[]

  @@map("tbl_pet_care_category")
}

model PetCareIcon {
  iconId   Int          @id @default(autoincrement()) @map("icon_id")
  iconName String       @unique(map: "tbl_pet_care_icon_name") @map("icon_name") @db.VarChar(50)
  iconKey  String       @map("icon_key") @db.VarChar(50)
  tips     PetCareTip[]

  @@map("tbl_pet_care_icon")
}

model PublicationStatus {
  statusId   Int            @id @default(autoincrement()) @map("status_id")
  statusName String         @unique(map: "tbl_publication_status_name") @map("status_name") @db.VarChar(30)
  tips       PetCareTip[]
  videos     ContentVideo[]

  @@map("tbl_publication_status")
}

model VideoCategory {
  videoCategoryId Int            @id @default(autoincrement()) @map("video_category_id")
  categoryName    String         @unique(map: "tbl_video_category_name") @map("category_name") @db.VarChar(80)
  isDeleted       Boolean        @default(false) @map("is_deleted")
  videos          ContentVideo[]

  @@map("tbl_video_category")
}

model ContentVideo {
  videoId             Int      @id @default(autoincrement()) @map("video_id")
  title               String   @db.VarChar(120)
  videoUrl            String   @map("video_url") @db.VarChar(500)
  categoryId          Int      @map("category_id")
  publicationStatusId Int      @map("publication_status_id")
  uploaderAccountId   Int      @map("uploader_account_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  isDeleted           Boolean  @default(false) @map("is_deleted")

  category          VideoCategory     @relation(fields: [categoryId], references: [videoCategoryId], onUpdate: Restrict)
  publicationStatus PublicationStatus @relation(fields: [publicationStatusId], references: [statusId], onUpdate: Restrict)
  uploader          Account           @relation(fields: [uploaderAccountId], references: [accountId], onUpdate: Restrict)

  @@map("tbl_content_video")
}

model Role {
  roleId   Int    @id @default(autoincrement()) @map("role_id")
  roleSlug String @unique(map: "tbl_role_slug") @map("role_slug") @db.VarChar(50)
  roleName String @map("role_name") @db.VarChar(100)

  accounts Account[]

  @@map("tbl_role")
}

model Service {
  serviceId   Int     @id @default(autoincrement()) @map("service_id")
  serviceName String  @map("service_name") @db.VarChar(100)
  description String? @db.VarChar(255)

  appointments Appointment[]
  visits       Visit[]

  @@map("tbl_service")
}

model Timeslot {
  timeslotId Int    @id @default(autoincrement()) @map("timeslot_id")
  startTime  String @map("start_time") @db.VarChar(5)
  endTime    String @map("end_time") @db.VarChar(5)
  display    String @db.VarChar(20)

  appointments Appointment[]

  @@map("tbl_timeslot")
}

model Veterinarian {
  vetId     Int     @id @default(autoincrement()) @map("vet_id")
  accountId Int     @unique @map("account_id")
  isDeleted Boolean @default(false) @map("is_deleted")

  account      Account                @relation(fields: [accountId], references: [accountId], onUpdate: Restrict, map: "tbl_veterinarian_tbl_account_FK")
  visits       Visit[]
  appointments Appointment[]
  schedules    VeterinarianSchedule[]
  timeOffs     VeterinarianTimeOff[]

  @@index([accountId], map: "tbl_veterinarian_tbl_account_FK")
  @@map("tbl_veterinarian")
}

model VeterinarianSchedule {
  scheduleId Int      @id @default(autoincrement()) @map("schedule_id")
  vetId      Int      @map("vet_id")
  dayOfWeek  Int      @map("day_of_week")
  startTime  String?  @map("start_time") @db.VarChar(5)
  endTime    String?  @map("end_time") @db.VarChar(5)
  note       String?  @db.VarChar(255)
  isDeleted  Boolean  @default(false) @map("is_deleted")
  assignerId Int?     @map("assigner_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(0)

  veterinarian Veterinarian @relation(fields: [vetId], references: [vetId], onUpdate: Restrict, map: "tbl_veterinarian_schedule_tbl_veterinarian_FK")

  @@index([vetId], map: "tbl_veterinarian_schedule_tbl_veterinarian_FK")
  @@map("tbl_veterinarian_schedule")
}

model VeterinarianTimeOff {
  timeOffId  Int           @id @default(autoincrement()) @map("time_off_id")
  vetId      Int           @map("vet_id")
  date       DateTime      @map("exception_date") @db.Date
  startTime  String?       @map("start_time") @db.VarChar(5)
  endTime    String?       @map("end_time") @db.VarChar(5)
  status     TimeOffStatus @default(Pending)
  reason     String?       @db.VarChar(255)
  note       String?       @db.VarChar(255)
  reviewerId Int           @map("reviewer_id")
  reviewedAt DateTime      @default(now()) @map("reviewed_at") @db.DateTime(0)
  createdAt  DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  isDeleted  Boolean       @default(false) @map("is_deleted")

  veterinarian Veterinarian @relation(fields: [vetId], references: [vetId], onUpdate: Restrict, map: "tbl_veterinarian_time_off_tbl_veterinarian_FK")

  @@index([vetId], map: "tbl_veterinarian_time_off_tbl_veterinarian_FK")
  @@map("tbl_veterinarian_time_off")
}

model Visit {
  visitId       Int         @id @default(autoincrement()) @map("visit_id")
  appointmentId Int?        @unique @map("appointment_id")
  vetId         Int         @map("vet_id")
  petId         Int         @map("pet_id")
  serviceId     Int         @map("service_id")
  visitType     VisitType   @default(Walk_in) @map("visit_type")
  visitDate     DateTime    @default(now()) @map("visit_date") @db.Date
  visitTime     DateTime    @default(now()) @map("visit_time") @db.Time(0)
  status        VisitStatus @default(Checked_in)
  isDeleted     Boolean     @default(false) @map("is_deleted")

  appointment    Appointment?     @relation(fields: [appointmentId], references: [appointmentId], onDelete: Restrict, onUpdate: Restrict, map: "tbl_visit_tbl_appointment_FK")
  pet            Pet              @relation(fields: [petId], references: [petId], onUpdate: Restrict, map: "tbl_visit_tbl_pet_FK")
  service        Service          @relation(fields: [serviceId], references: [serviceId], onUpdate: Restrict, map: "tbl_visit_tbl_service_FK")
  veterinarian   Veterinarian     @relation(fields: [vetId], references: [vetId], onDelete: Restrict, onUpdate: Restrict, map: "tbl_visit_tbl_veterinarian_FK")
  medicalRecords MedicalHistory[]
  labResults     LabResult[]

  @@index([appointmentId], map: "tbl_visit_tbl_appointment_FK")
  @@index([petId], map: "tbl_visit_tbl_pet_FK")
  @@index([serviceId], map: "tbl_visit_tbl_service_FK")
  @@map("tbl_visit")
}

enum AuditLogAction {
  Created
  Updated
  Deleted

  @@map("tbl_audit_log_action")
}

enum PetBreedSpecies {
  Cat
  Dog

  @@map("tbl_pet_breed_species")
}

enum PetGender {
  Male
  Female

  @@map("tbl_pet_gender")
}

enum AppointmentStatus {
  Pending
  Upcoming
  Rejected
  Completed
  Missed
  Cancelled

  @@map("tbl_appointment_status")
}

enum VisitStatus {
  Checked_in @map("Checked-in")
  Ongoing
  Completed

  @@map("tbl_visit_status")
}

enum TimeOffStatus {
  Pending
  Approved
  Rejected

  @@map("tbl_veterinarian_time_off_status")
}

enum PetCareTipType {
  Article
  Video

  @@map("tbl_pet_care_tips_type")
}

enum VisitType {
  Walk_in     @map("Walk-in")
  Appointment
  Follow_up   @map("Follow-up")

  @@map("tbl_visit_type")
}

enum LabResultStatus {
  Pending
  Final
}
